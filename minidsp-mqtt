#!/usr/bin/env python3
# minidsp-mqtt — bridges minidsp-rs (minidspd HTTP/WS API) to MQTT with
# Home Assistant autodiscovery.
#
# Scope: master volume / mute / source / preset / device info.
# The volume curve mirrors squeezelite-volume so the LMS slider, IR remote,
# and HA slider all agree on the same dB value:
#
#     gain_dB = FLOOR_DB * (1 - (vol/100)^CURVE_K)        for vol >= 1
#     vol = 0 -> gain = -127 dB (hard mute)
#
# Configuration via environment (see /etc/default/minidsp-mqtt and
# /etc/default/squeezelite):
#
#     MINIDSPD_URL       http://127.0.0.1:5380
#     DEVICE_INDEX       0
#     MQTT_HOST          192.168.1.3
#     MQTT_PORT          1883
#     MQTT_USER          mqtt
#     MQTT_PASS          mqtt
#     BASE_TOPIC         minidsp
#     DISCOVERY_PREFIX   homeassistant
#     NODE_ID            minidsp                (used in MQTT topics + unique_id)
#     FLOOR_DB           -50                    (sourced from /etc/default/squeezelite)
#     CURVE_K            1                      (sourced from /etc/default/squeezelite)
#     LMS_VOL_FILE       /tmp/sq-volume-req     (squeezelite-volume's REQFILE)
#     SOURCES            (empty = auto-discover from product_name)
#     MUTE_SENTINEL_DB   -100                   (gain at/below = drop volume publish)
#     LOG_LEVEL          INFO

import asyncio
import json
import logging
import os
import signal
import time
from contextlib import suppress

import httpx
import paho.mqtt.client as mqtt
import websockets


MINIDSPD_URL     = os.environ.get("MINIDSPD_URL", "http://127.0.0.1:5380").rstrip("/")
DEVICE_INDEX     = int(os.environ.get("DEVICE_INDEX", "0"))

MQTT_HOST        = os.environ.get("MQTT_HOST", "192.168.1.3")
MQTT_PORT        = int(os.environ.get("MQTT_PORT", "1883"))
MQTT_USER        = os.environ.get("MQTT_USER", "mqtt")
MQTT_PASS        = os.environ.get("MQTT_PASS", "mqtt")

BASE_TOPIC       = os.environ.get("BASE_TOPIC", "minidsp")
DISCOVERY_PREFIX = os.environ.get("DISCOVERY_PREFIX", "homeassistant")
NODE_ID          = os.environ.get("NODE_ID", "minidsp")

# Forward curve matches squeezelite-volume exactly:
#     gain_dB = FLOOR_DB * (1 - (vol/100)^CURVE_K)
# These vars are sourced from /etc/default/squeezelite via the bridge's
# systemd EnvironmentFile, so a single edit keeps the LMS path and the
# HA path on the same curve.
FLOOR_DB         = float(os.environ.get("FLOOR_DB", "-50"))
CURVE_K          = float(os.environ.get("CURVE_K",  "1"))

# For LMS-driven state, read the integer vol that squeezelite-volume just
# received from squeezelite (and wrote to this file as its first line of
# work). That value is **squeezelite-vol** — what squeezelite computed
# from LMS's AUDG gain — not the LMS UI slider position; LMS's internal
# slider→AUDG curve differs from squeezelite's AUDG→vol formula, so the
# two diverge by up to ~20 points across the range. CALIBRATION (below)
# maps between them so HA can display the LMS UI slider value exactly.
LMS_VOL_FILE     = os.environ.get("LMS_VOL_FILE", "/tmp/sq-volume-req")

# Per-install calibration: maps LMS UI slider positions to the integer
# squeezelite VOL that squeezelite-volume actually receives for that
# LMS slider position. Used in both directions so the HA slider displays
# the LMS UI slider value exactly.
#
# Default was measured on 2026-05 by sweeping LMS volume 0..100 by 10
# and reading /tmp/sq-volume-req at each step. Override per install via:
#
#   ./squeezelite-ctl.sh set calibration="0:0,10:18,...,100:100"
#
# Format: comma-separated `<lms>:<sq>` pairs, sorted by lms ascending.
# To re-measure: stop LMS playback fade-in (or just play music), call
# `<player> mixer volume <V>` for V in [0,10,…,100], read the file each
# time, paste the pairs into CALIBRATION.
CALIBRATION_DEFAULT = ("0:0,10:18,20:38,30:52,40:58,50:66,"
                       "60:72,70:80,80:86,90:93,100:100")
CALIBRATION         = os.environ.get("CALIBRATION", CALIBRATION_DEFAULT)

# Best-effort LMS push. After a HA-driven volume change, the bridge can
# tell LMS to update its own slider state so LMS doesn't later re-assert
# its (stale) slider position and overwrite HA's write. Skipped if either
# var is empty. LMS unreachable is non-fatal — direct device control on
# HA side keeps working.
LMS_HOST         = os.environ.get("LMS_HOST", "").strip()
LMS_HTTP_PORT    = int(os.environ.get("LMS_HTTP_PORT", "9000"))
LMS_PLAYER_MAC   = os.environ.get("LMS_PLAYER_MAC", "").strip()
LMS_RPC_URL      = (f"http://{LMS_HOST}:{LMS_HTTP_PORT}/jsonrpc.js"
                    if LMS_HOST and LMS_PLAYER_MAC else None)


def _parse_calibration(spec):
    pairs = []
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        try:
            lms_s, sq_s = chunk.split(":", 1)
            pairs.append((int(lms_s), int(sq_s)))
        except (ValueError, AttributeError):
            log.warning("CALIBRATION: ignoring malformed pair %r", chunk)
    if not pairs:
        # Sane fallback: identity. Avoids zero-length table arithmetic.
        pairs = [(0, 0), (100, 100)]
    pairs.sort(key=lambda p: p[0])
    return pairs


def _interp(x, pairs, key_idx, val_idx):
    """Piecewise-linear interpolation across a sorted (sorted by pairs[*][key_idx]) list."""
    if x <= pairs[0][key_idx]:
        return pairs[0][val_idx]
    if x >= pairs[-1][key_idx]:
        return pairs[-1][val_idx]
    for i in range(len(pairs) - 1):
        x0, x1 = pairs[i][key_idx], pairs[i+1][key_idx]
        if x0 <= x <= x1:
            y0, y1 = pairs[i][val_idx], pairs[i+1][val_idx]
            if x1 == x0:
                return y0
            t = (x - x0) / (x1 - x0)
            return y0 + t * (y1 - y0)
    return pairs[-1][val_idx]


def lms_to_sq(lms_vol: int) -> int:
    """LMS UI slider (0-100) → integer squeezelite-vol via CALIBRATION."""
    return int(round(_interp(lms_vol, _CALIB_BY_LMS, 0, 1)))


def sq_to_lms(sq_vol: int) -> int:
    """Inverse: squeezelite-vol → LMS UI slider via CALIBRATION."""
    return int(round(_interp(sq_vol, _CALIB_BY_SQ, 1, 0)))

# Defensive: if some other path (older squeezelite-volume, a manual
# `minidsp gain -127`, a future regression) hard-mutes the device, don't
# republish the resulting near-floor gain to HA — preserve the prior
# user-meaningful slider position. The bridge's legitimate gain range is
# [FLOOR_DB, 0]; anything well below that is treated as a sentinel.
# squeezelite-volume's slider=0 path is itself a no-op now (no device write),
# so in normal operation this filter never fires.
MUTE_SENTINEL_DB = float(os.environ.get("MUTE_SENTINEL_DB", "-100"))

# Per-product source enumeration. minidsp-rs's HTTP API does not expose the
# available sources for a given device, only its product_name; the CLI's
# --help lists the *union* of every product's enum. We map known
# product_name values to their accepted source names. Names must match what
# minidsp-rs accepts (case-insensitive on input; canonical TitleCase here).
#
# VERIFIED entries were probed empirically by POSTing each candidate source
# from minidsp-rs's full enum to /devices/0/config and reading back
# master.source. Unverified entries are best-effort guesses — if HA shows
# options that don't actually switch on your device, override with the
# SOURCES env var (e.g. ./squeezelite-ctl.sh set sources=Analog,Toslink,Usb).
PRODUCT_SOURCES  = {
    # Verified on hw_id=10 fw=1.85 (2026-05):
    "DDRC-24":  ["Analog", "Toslink", "Usb"],

    # Unverified — submit a PR (or update the SOURCES override) if wrong:
    "2x4HD":    ["Analog", "Toslink", "Usb"],
    "DDRC-88A": ["Analog", "Toslink", "Aesebu"],
    "SHD":      ["Analog", "Toslink", "Spdif", "Usb"],
    "Flex":     ["Analog", "Toslink", "Spdif", "Usb"],
    "Studio":   ["Analog", "Usb"],
}

# Optional explicit override via env. Empty string / unset = auto-discover
# from product_name. Set this to force a specific list (or to support a
# product we haven't mapped yet).
SOURCES_OVERRIDE = [s.strip() for s in
                    os.environ.get("SOURCES", "").split(",")
                    if s.strip()]
PRESETS          = ["Config 1", "Config 2", "Config 3", "Config 4"]


def discover_sources(devinfo):
    """Resolve which source names to expose to HA.

    1. SOURCES env var, if set → wins.
    2. PRODUCT_SOURCES[product_name], if known.
    3. A safe minimal fallback. Logs a warning so the user knows to override.
    """
    if SOURCES_OVERRIDE:
        return SOURCES_OVERRIDE
    product = (devinfo.get("product_name") or "").strip()
    if product in PRODUCT_SOURCES:
        log.info("auto-discovered sources for %s: %s",
                 product, PRODUCT_SOURCES[product])
        return PRODUCT_SOURCES[product]
    log.warning("unknown product_name %r — falling back to generic sources; "
                "set SOURCES=... to override", product)
    return ["Analog", "Toslink", "Usb"]

logging.basicConfig(
    level=os.environ.get("LOG_LEVEL", "INFO"),
    format="%(asctime)s %(levelname)s %(message)s",
)
log = logging.getLogger("minidsp-mqtt")

# CALIBRATION tables: sorted by LMS column for forward lookup, by sq column
# for inverse. Built once at import. _parse_calibration logs warnings via
# `log`, so this must come after `log` is set up.
_CALIB_PAIRS  = _parse_calibration(CALIBRATION)
_CALIB_BY_LMS = sorted(_CALIB_PAIRS, key=lambda p: p[0])
_CALIB_BY_SQ  = sorted(_CALIB_PAIRS, key=lambda p: p[1])
log.info("calibration: %s", _CALIB_PAIRS)


# ── volume curve (matches squeezelite-volume exactly) ───────────────────
# Same `gain = FLOOR_DB * (1 - (vol/100)^CURVE_K)` formula as the script.
# State is normally sourced from LMS_VOL_FILE (see read_lms_vol below) so
# this inverse is only used as a fallback when the file is missing.
def vol_to_db(vol: int) -> float:
    if vol <= 0:
        # HA slider 0 → device floor (NOT -127 hard mute; that's the
        # squeezelite-pause sentinel filtered by MUTE_SENTINEL_DB).
        return FLOOR_DB
    v = max(1, min(100, int(vol)))
    return FLOOR_DB * (1.0 - (v / 100.0) ** CURVE_K)


def db_to_vol(db: float) -> int:
    if db <= -127.0 + 1.0:
        return 0
    if FLOOR_DB >= 0 or CURVE_K <= 0:
        return 100
    g = max(FLOOR_DB, min(0.0, db))
    ratio = max(0.0, min(1.0, 1.0 - g / FLOOR_DB))
    vol = round(100.0 * (ratio ** (1.0 / CURVE_K)))
    return max(0, min(100, vol))


def read_lms_vol():
    """Return the integer VOL squeezelite-volume last received from
    squeezelite, or None if the file is missing / unreadable / malformed.
    This is the byte-exact LMS slider position, so we prefer it over the
    inverse curve for HA state when available."""
    try:
        with open(LMS_VOL_FILE, "r") as f:
            return max(0, min(100, int(f.read().strip())))
    except (OSError, ValueError):
        return None


# ── topic helpers ────────────────────────────────────────────────────────
def t_state(field):  return f"{BASE_TOPIC}/{NODE_ID}/master/{field}"
def t_set(field):    return f"{BASE_TOPIC}/{NODE_ID}/master/{field}/set"
def t_status():      return f"{BASE_TOPIC}/{NODE_ID}/status"
def disco_topic(component, obj):
    return f"{DISCOVERY_PREFIX}/{component}/{NODE_ID}/{obj}/config"


# ── HA discovery payloads ────────────────────────────────────────────────
def device_block(devinfo):
    product = devinfo.get("product_name") or devinfo.get("product") or "MiniDSP"
    return {
        "identifiers":  [f"minidsp_{NODE_ID}"],
        "manufacturer": "MiniDSP",
        "model":        product,
        "name":         f"MiniDSP ({NODE_ID})",
        "sw_version":   str(devinfo.get("version", "")) or "minidsp-rs",
    }


def availability_block():
    return [{
        "topic":                 t_status(),
        "payload_available":     "online",
        "payload_not_available": "offline",
    }]


def discovery_payloads(devinfo, sources):
    common = {
        "device":       device_block(devinfo),
        "availability": availability_block(),
        "qos":          1,
    }
    yield ("number", "master_volume", {
        **common,
        "name":                "Volume",
        "unique_id":           f"{NODE_ID}_master_volume",
        "command_topic":       t_set("volume"),
        "state_topic":         t_state("volume"),
        "min": 0, "max": 100, "step": 1,
        "mode":                "slider",
        "unit_of_measurement": "%",
        "icon":                "mdi:volume-high",
    })
    yield ("switch", "master_mute", {
        **common,
        "name":          "Mute",
        "unique_id":     f"{NODE_ID}_master_mute",
        "command_topic": t_set("mute"),
        "state_topic":   t_state("mute"),
        "payload_on":    "ON",
        "payload_off":   "OFF",
        "icon":          "mdi:volume-off",
    })
    yield ("select", "master_source", {
        **common,
        "name":          "Source",
        "unique_id":     f"{NODE_ID}_master_source",
        "command_topic": t_set("source"),
        "state_topic":   t_state("source"),
        "options":       sources,
        "icon":          "mdi:audio-input-rca",
    })
    yield ("select", "master_preset", {
        **common,
        "name":          "Preset",
        "unique_id":     f"{NODE_ID}_master_preset",
        "command_topic": t_set("preset"),
        "state_topic":   t_state("preset"),
        "options":       PRESETS,
        "icon":          "mdi:tune-variant",
    })


# ── command coalescer ───────────────────────────────────────────────────
# When HA / MQTT publishes a flurry of commands (e.g. dragging the Volume
# slider 0->100), the bridge previously fired one HTTP POST per command.
# minidspd serialises HID writes through one connection, so 100 rapid
# commands queued ~100 device round-trips, blocking subsequent commands
# and leaving HA's slider lagging. The coalescer collapses bursts: the
# latest target replaces any pending one and a single dispatch fires after
# COALESCE_DELAY of quiet.
COALESCE_DELAY = float(os.environ.get("COALESCE_DELAY", "0.05"))


class Coalescer:
    def __init__(self, loop, delay):
        self.loop = loop
        self.delay = delay
        self.target = None        # latest payload seen
        self.task = None          # pending dispatch task

    def submit(self, target, dispatch):
        """Replace the pending target. dispatch is an async callable invoked
        with the (final) target after `delay` seconds of quiet."""
        self.target = target
        if self.task and not self.task.done():
            self.task.cancel()
        self.task = self.loop.create_task(self._run(dispatch))

    async def _run(self, dispatch):
        try:
            await asyncio.sleep(self.delay)
        except asyncio.CancelledError:
            return
        try:
            await dispatch(self.target)
        except Exception as e:
            log.error("coalesced dispatch failed: %s", e)


# ── bridge ───────────────────────────────────────────────────────────────
class Bridge:
    def __init__(self, loop):
        self.loop = loop
        self.http = httpx.AsyncClient(base_url=MINIDSPD_URL, timeout=5.0)
        self._coalescers = {}     # field -> Coalescer

        self.mqtt = mqtt.Client(client_id=f"minidsp-mqtt-{NODE_ID}",
                                clean_session=True)
        if MQTT_USER:
            self.mqtt.username_pw_set(MQTT_USER, MQTT_PASS)
        self.mqtt.will_set(t_status(), "offline", qos=1, retain=True)
        self.mqtt.on_connect = self._on_mqtt_connect
        self.mqtt.on_message = self._on_mqtt_message
        self.mqtt.on_disconnect = self._on_mqtt_disconnect

        # Track the last time we received any inbound MQTT message, so
        # the watchdog can detect "broker silently dropped our subscriptions"
        # — TCP stays up, on_connect never re-fires, command topics
        # deliver into a void. Updated by _on_mqtt_message.
        self.last_inbound_ms = 0

        # Bridge-initiated write tracker. When HA pushes a volume change
        # we POST a dB value AND echo the HA-input integer to the state
        # topic. The WS will subsequently report that same dB back; if it
        # matches `last_written_gain` (±0.5 dB) and is fresh (≤3 s), we
        # suppress the volume re-publish so a stale /tmp/sq-volume-req
        # read can't clobber the echoed value.
        self.last_written_gain = None
        self.last_written_ts   = 0.0

    def _coalescer(self, field):
        if field not in self._coalescers:
            self._coalescers[field] = Coalescer(self.loop, COALESCE_DELAY)
        return self._coalescers[field]

    # ── HTTP helpers ─────────────────────────────────────────────────────
    async def fetch_devices(self):
        r = await self.http.get("/devices")
        r.raise_for_status()
        devs = r.json()
        if not devs:
            raise RuntimeError("minidspd reports no devices")
        if DEVICE_INDEX >= len(devs):
            raise RuntimeError(
                f"DEVICE_INDEX={DEVICE_INDEX} but only {len(devs)} device(s)")
        return devs[DEVICE_INDEX]

    async def fetch_master(self):
        r = await self.http.get(f"/devices/{DEVICE_INDEX}")
        r.raise_for_status()
        return (r.json() or {}).get("master") or {}

    async def _lms_set_volume(self, vol_str):
        """Fire-and-forget JSON-RPC push to LMS so its slider stays in
        sync with HA-driven changes. 2-second timeout; any failure is
        logged at DEBUG and swallowed."""
        try:
            async with httpx.AsyncClient(timeout=2.0) as client:
                await client.post(LMS_RPC_URL, json={
                    "id": 1,
                    "method": "slim.request",
                    "params": [LMS_PLAYER_MAC,
                               ["mixer", "volume", str(vol_str)]],
                })
        except Exception as e:
            log.debug("LMS push %s=%s failed: %s: %s",
                      LMS_PLAYER_MAC, vol_str,
                      type(e).__name__, e or "(no message)")

    async def post_config(self, patch, attempts=3):
        """POST a config patch to minidspd with bounded retries.

        minidspd's HID receive loop occasionally stalls for sub-second
        windows (the minidsp-watchdog handles long stalls; this covers
        the gap before it notices). Retry transient httpx errors and
        5xx responses with short backoff; bail immediately on 4xx
        (the patch is malformed — retrying won't help).
        """
        last_exc = None
        for i in range(attempts):
            try:
                r = await self.http.post(
                    f"/devices/{DEVICE_INDEX}/config", json=patch)
                if r.status_code < 400:
                    if i > 0:
                        log.info("POST recovered on attempt %d/%d",
                                 i + 1, attempts)
                    return
                if 400 <= r.status_code < 500:
                    log.error("POST /devices/%s/config %s -> %s %s",
                              DEVICE_INDEX, patch, r.status_code, r.text)
                    r.raise_for_status()
                # 5xx — retryable
                last_exc = httpx.HTTPStatusError(
                    f"server returned {r.status_code}",
                    request=r.request, response=r)
            except httpx.HTTPError as e:
                last_exc = e
            if i < attempts - 1:
                delay = 0.2 * (2 ** i)
                log.warning("POST attempt %d/%d failed (%s); retry in %.1fs",
                            i + 1, attempts,
                            type(last_exc).__name__, delay)
                await asyncio.sleep(delay)
        raise last_exc

    # ── MQTT publish helpers ─────────────────────────────────────────────
    def publish(self, topic, payload, retain=True, qos=1):
        self.mqtt.publish(topic, payload, qos=qos, retain=retain)

    def _publish_volume_state(self, gain: float):
        """Pick the LMS-UI-equivalent vol for a device gain reading and
        publish it to the state topic.

        Priority:
          1. If this WS event is the echo of our own recent HA-driven
             POST (|gain - last_written_gain| <= 0.5 dB, within 3 s),
             suppress — HA already saw the echoed value at command time.
          2. Else read /tmp/sq-volume-req — that's the integer
             squeezelite-vol squeezelite-volume just received. Run it
             through the CALIBRATION table to get the matching LMS UI
             slider value, then publish.
          3. Else fall back to inverse curve from gain → squeezelite-vol
             → CALIBRATION → LMS UI value.
        """
        now = time.monotonic()
        if (self.last_written_gain is not None
            and (now - self.last_written_ts) <= 3.0
            and abs(gain - self.last_written_gain) <= 0.5):
            log.debug("WS echo of own write (%.1f dB); state already published",
                      gain)
            return
        sq = read_lms_vol()
        if sq is None:
            sq = db_to_vol(gain)
            log.debug("LMS_VOL_FILE unavailable; using inverse curve -> sq=%d", sq)
        lms_vol = sq_to_lms(sq)
        self.publish(t_state("volume"), str(lms_vol))

    def publish_master(self, master: dict):
        if not master:
            return
        if "volume" in master and master["volume"] is not None:
            gain = float(master["volume"])
            if gain <= MUTE_SENTINEL_DB:
                log.debug("ignoring near-floor gain=%.1f (suspected pause-mute)", gain)
            else:
                self._publish_volume_state(gain)
        if "mute" in master and master["mute"] is not None:
            self.publish(t_state("mute"), "ON" if master["mute"] else "OFF")
        if "source" in master and master["source"] is not None:
            self.publish(t_state("source"), str(master["source"]))
        if "preset" in master and master["preset"] is not None:
            try:
                idx = int(master["preset"])
            except (TypeError, ValueError):
                idx = -1
            if 0 <= idx < len(PRESETS):
                self.publish(t_state("preset"), PRESETS[idx])

    def publish_discovery(self, devinfo, sources):
        for component, obj, payload in discovery_payloads(devinfo, sources):
            self.publish(disco_topic(component, obj), json.dumps(payload))

    # ── MQTT callbacks (paho thread) ─────────────────────────────────────
    def _subscribe_command_topics(self):
        for f in ("volume", "mute", "source", "preset"):
            self.mqtt.subscribe(t_set(f), qos=1)

    def _on_mqtt_connect(self, client, userdata, flags, rc):
        if rc != 0:
            log.error("MQTT connect failed rc=%s", rc)
            return
        log.info("MQTT connected to %s:%s", MQTT_HOST, MQTT_PORT)
        self.mqtt.publish(t_status(), "online", qos=1, retain=True)
        self._subscribe_command_topics()

    def _on_mqtt_disconnect(self, client, userdata, rc):
        # rc==0 → graceful (our own disconnect on shutdown). Otherwise
        # paho's network thread saw a TCP-level loss and will auto-reconnect;
        # on_connect will fire again and re-subscribe.
        if rc != 0:
            log.warning("MQTT unexpected disconnect rc=%s (auto-reconnect)", rc)

    def _on_mqtt_message(self, client, userdata, msg):
        # Track inbound activity so the watchdog can spot "subs silently dropped"
        # cases where the broker stops delivering messages but TCP stays up.
        self.last_inbound_ms = int(time.monotonic() * 1000)
        try:
            payload = msg.payload.decode("utf-8", "replace").strip()
        except Exception:
            log.exception("decode error on %s", msg.topic)
            return
        # topic shape: BASE_TOPIC/NODE_ID/master/<field>/set
        parts = msg.topic.split("/")
        if len(parts) < 2 or parts[-1] != "set":
            return
        field = parts[-2]
        log.debug("mqtt cmd %s = %r", field, payload)
        # Coalesce per-field: a burst of rapid commands collapses to one
        # dispatch with the latest payload. Runs on the asyncio loop, called
        # from paho's thread, so use loop.call_soon_threadsafe.
        coalescer = self._coalescer(field)
        async def dispatch(p): await self._handle_command(field, p)
        self.loop.call_soon_threadsafe(coalescer.submit, payload, dispatch)

    async def _handle_command(self, field, payload):
        try:
            patch = self._build_patch(field, payload)
            if patch is None:
                log.warning("ignoring unrecognised command %s=%r", field, payload)
                return
            # For HA-driven volume changes: echo the user's exact integer
            # to the state topic and mark the upcoming WS feedback as "ours"
            # so it doesn't trigger a stale LMS_VOL_FILE read.
            if field == "volume":
                target_db = patch.get("master_status", {}).get("volume")
                if target_db is not None:
                    self.last_written_gain = float(target_db)
                    self.last_written_ts   = time.monotonic()
                    self.publish(t_state("volume"), payload.strip())
            await self.post_config(patch)
            # Best-effort: tell LMS to update its own slider too, so it
            # doesn't later re-assert a stale position and overwrite us.
            # Errors are intentionally swallowed — HA-only control must
            # work when LMS is unreachable.
            if field == "volume" and LMS_RPC_URL:
                await self._lms_set_volume(payload.strip())
        except Exception as e:
            log.error("command %s=%r failed: %s: %s",
                      field, payload, type(e).__name__, e or "(no message)")

    def _build_patch(self, field, payload):
        if field == "volume":
            try:
                # HA volume is the LMS UI slider position. Translate to
                # the squeezelite-vol the script would have produced for
                # that LMS slider (via CALIBRATION) before applying the
                # script's curve to compute device dB. Forward + inverse
                # paths agree by construction.
                lms_vol = int(round(float(payload)))
            except ValueError:
                return None
            lms_vol = max(0, min(100, lms_vol))
            sq_target = lms_to_sq(lms_vol)
            return {"master_status": {"volume": round(vol_to_db(sq_target), 2)}}
        if field == "mute":
            on = payload.upper() in ("ON", "1", "TRUE", "YES")
            return {"master_status": {"mute": on}}
        if field == "source":
            return {"master_status": {"source": payload}}
        if field == "preset":
            p = None
            try:
                n = int(payload)
                if 1 <= n <= 4:
                    p = n - 1
                elif 0 <= n <= 3:
                    p = n
            except ValueError:
                if payload in PRESETS:
                    p = PRESETS.index(payload)
            if p is None:
                return None
            return {"master_status": {"preset": p}}
        return None

    # ── MQTT health watchdog ─────────────────────────────────────────────
    async def mqtt_health_loop(self):
        """Defensive against broker-side subscription loss.

        Symptom observed in the field: outbound publishes (state reports)
        keep working, but inbound command topics (HA → bridge) stop being
        delivered. TCP stays connected, so paho never fires on_disconnect
        and on_connect's resubscribe never re-runs. Only a process restart
        recovers.

        Cause is broker dropping our subscription state without dropping
        the connection — e.g. broker restart with persistent sessions
        disabled, network proxy keeping TCP alive across a backend hiccup.

        Defence: every 5 minutes, idempotently re-issue SUBSCRIBE for every
        command topic. If paho is unhealthy (network thread died, or no
        inbound traffic for too long), force a reconnect.
        """
        SILENCE_LIMIT_MS = 30 * 60 * 1000   # 30 min of zero inbound = suspect
        INTERVAL_S       = 300              # check + re-sub every 5 min

        await asyncio.sleep(INTERVAL_S)
        while True:
            try:
                connected = self.mqtt.is_connected()
                thread = getattr(self.mqtt, "_thread", None)
                thread_alive = thread is not None and thread.is_alive()
                now_ms = int(time.monotonic() * 1000)
                silence_ms = (now_ms - self.last_inbound_ms
                              if self.last_inbound_ms else 0)

                if not connected or not thread_alive:
                    log.warning(
                        "MQTT unhealthy (connected=%s thread_alive=%s); "
                        "bouncing client", connected, thread_alive)
                    await self.loop.run_in_executor(None, self._mqtt_bounce)
                elif silence_ms > SILENCE_LIMIT_MS:
                    log.warning(
                        "MQTT silent for %ds (no inbound); resubscribing + "
                        "bouncing as a precaution", silence_ms // 1000)
                    await self.loop.run_in_executor(None, self._mqtt_bounce)
                else:
                    log.debug("MQTT health OK (silence=%ds); re-subscribing",
                              silence_ms // 1000)
                    self._subscribe_command_topics()
            except Exception as e:
                log.error("mqtt_health_loop: %s: %s",
                          type(e).__name__, e or "(no message)")
            await asyncio.sleep(INTERVAL_S)

    def _mqtt_bounce(self):
        """Synchronous reconnect helper. Runs in executor so it doesn't
        block the asyncio loop. paho.Client.reconnect() is blocking."""
        with suppress(Exception):
            self.mqtt.loop_stop()
        with suppress(Exception):
            self.mqtt.reconnect()
        with suppress(Exception):
            self.mqtt.loop_start()

    # ── WS state stream ──────────────────────────────────────────────────
    async def ws_loop(self):
        scheme = "wss" if MINIDSPD_URL.startswith("https") else "ws"
        host = MINIDSPD_URL.split("://", 1)[1]
        url = f"{scheme}://{host}/devices/{DEVICE_INDEX}?poll=true"
        backoff = 1
        while True:
            try:
                log.info("WS connecting %s", url)
                # ping_interval=None: minidspd doesn't reply to client pings,
                # so an active client ping kills the connection every ~60s.
                # The minidspd-side push of state events keeps the conn alive.
                async with websockets.connect(url, ping_interval=None) as ws:
                    backoff = 1
                    async for raw in ws:
                        try:
                            data = json.loads(raw)
                        except Exception:
                            continue
                        master = data.get("master") if isinstance(data, dict) else None
                        if master:
                            self.publish_master(master)
            except asyncio.CancelledError:
                raise
            except Exception as e:
                log.warning("WS dropped (%s); reconnect in %ss", e, backoff)
                await asyncio.sleep(backoff)
                backoff = min(60, backoff * 2)

    # ── orchestration ────────────────────────────────────────────────────
    async def run(self):
        # wait for minidspd to be reachable before announcing anything
        while True:
            try:
                devinfo = await self.fetch_devices()
                break
            except Exception as e:
                log.info("waiting for minidspd: %s", e)
                await asyncio.sleep(2)

        log.info("device: %s", devinfo)
        sources = discover_sources(devinfo)
        log.info("HA source select options: %s", sources)

        self.mqtt.connect_async(MQTT_HOST, MQTT_PORT, keepalive=30)
        self.mqtt.loop_start()
        await asyncio.sleep(1)  # let MQTT settle so retained discovery arrives

        self.publish_discovery(devinfo, sources)

        master = await self.fetch_master()
        self.publish_master(master)

        # Run the MQTT health watchdog alongside the WS reader.
        asyncio.create_task(self.mqtt_health_loop())
        await self.ws_loop()

    async def close(self):
        with suppress(Exception):
            self.mqtt.publish(t_status(), "offline", qos=1, retain=True)
        with suppress(Exception):
            self.mqtt.loop_stop()
            self.mqtt.disconnect()
        with suppress(Exception):
            await self.http.aclose()


def main():
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    bridge = Bridge(loop)
    stop = asyncio.Event()

    def _sig(*_):
        loop.call_soon_threadsafe(stop.set)

    signal.signal(signal.SIGTERM, _sig)
    signal.signal(signal.SIGINT, _sig)

    async def runner():
        task = asyncio.create_task(bridge.run())
        wait_stop = asyncio.create_task(stop.wait())
        done, pending = await asyncio.wait(
            {task, wait_stop}, return_when=asyncio.FIRST_COMPLETED)
        for p in pending:
            p.cancel()
            with suppress(asyncio.CancelledError):
                await p
        await bridge.close()

    try:
        loop.run_until_complete(runner())
    finally:
        loop.close()


if __name__ == "__main__":
    main()
